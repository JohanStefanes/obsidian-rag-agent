# Copy to .env and adjust. All values have sensible defaults in config.py.

# Absolute path to the Obsidian vault to index.
VAULT_PATH="/path/to/your/Obsidian Vault"

# Ollama endpoint (local).
OLLAMA_HOST="http://localhost:11434"

# Models (must be pulled: `ollama pull bge-m3`, `ollama pull qwen2.5:7b-instruct`).
EMBED_MODEL="bge-m3"
CHAT_MODEL="qwen2.5:7b-instruct"

# Where the SQLite index lives (relative paths resolve against the repo root).
DB_PATH="data/vault-index.db"

# Retrieval defaults.
TOP_K="6"
